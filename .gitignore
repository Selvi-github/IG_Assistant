# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production build outputs
frontend/dist/
backend/dist/

# Environment files with private secrets
.env
backend/.env
frontend/.env
*.local

# SQLite Database and generated media files
backend/data/*.db*
backend/data/generated_images/*
!backend/data/generated_images/.gitkeep
backend/data/generated_videos/*
!backend/data/generated_videos/.gitkeep
data/

# Logs and system files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.pptx
__pycache__/
*.pyc

# IDE files
.vscode/
.idea/

